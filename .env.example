# AXE PRIME — exemplo de configuração
# Copie para .env.local, use segredos exclusivos por ambiente e nunca versione
# credenciais reais. Em produção, todos os endpoints devem usar HTTPS.

NODE_ENV=development

# PostgreSQL
# Percent-encode usuário/senha quando contiverem caracteres reservados de URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

DATABASE_MIGRATION_URL=

# Role temporária e restrita para a importação única de avatares. Obrigatória
# sempre que o job for executado e diferente das roles runtime e migradora.
# Não injete esta variável no processo web e remova-a ao concluir o job.
DATABASE_AVATAR_IMPORT_URL=

# Produção: use verify-full com CA confiável. No Railway, quando DATABASE_URL
# aponta para *.railway.internal e o Postgres apresenta CA autossinada, use
# require (TLS sem validação da CA) somente dentro da rede privada do projeto.
# Para PostgreSQL local sem TLS: disable.
DATABASE_SSL_MODE=verify-full

# Opcional: certificado da CA privada em PEM, com quebras de linha como \n.
# Não é necessário quando a CA já pertence ao trust store do sistema.
DATABASE_CA_CERT=

DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
DATABASE_MIGRATION_LOCK_TIMEOUT_MS=10000
DATABASE_MIGRATION_STATEMENT_TIMEOUT_MS=300000

# Autenticação
# Gere valores independentes com: openssl rand -base64 48
# Ambos precisam decodificar para pelo menos 32 bytes aleatórios.
JWT_ACCESS_SECRET=
AUTH_TOKEN_PEPPER=

JWT_ISSUER=axe-prime
JWT_AUDIENCE=axe-prime-api
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
PASSWORD_RESET_TTL_SECONDS=3600
PASSWORD_SCRYPT_CONCURRENCY=2
PASSWORD_SCRYPT_QUEUE_LIMIT=8
AUTH_LOGIN_GLOBAL_LIMIT=60
AUTH_REFRESH_GLOBAL_LIMIT=120
AUTH_RECORD_RETENTION_DAYS=7

# Entrega de recuperação de senha por serviço interno HTTPS. Enquanto estes
# três valores não estiverem configurados, a API responde 503 para qualquer
# e-mail e não cria tokens. O webhook recebe um POST JSON autenticado por
# Bearer e deve enviar o resetUrl ao destinatário.
APP_PUBLIC_URL=https://axe-prime-production.up.railway.app
PASSWORD_RESET_WEBHOOK_URL=https://notifications.example.com/hooks/password-reset
PASSWORD_RESET_WEBHOOK_BEARER_TOKEN=

# Migração única de avatares externos. Informe somente os hostnames HTTPS exatos
# do storage antigo, separados por vírgula; remova depois da migração.
LEGACY_AVATAR_ALLOWED_HOSTS=

# Origens públicas canônicas aceitas na verificação de requisições. Isto não
# habilita CORS: o frontend de navegador permanece estritamente same-origin.
# Use localhost somente em desenvolvimento.
AUTH_ALLOWED_ORIGINS=https://axe-prime-production.up.railway.app

# Logs de monitoria de segurança (rejeições de origin/fetch/csrf).
# true em ambiente de desenvolvimento/QA; em produção, ative apenas para diagnóstico.
REQUEST_SECURITY_LOG=true

# Ative apenas quando a aplicação estiver atrás de um proxy reverso confiável
# que sobrescreva (não apenas acrescente) Forwarded/X-Forwarded-*.
TRUST_PROXY_HEADERS=false
